SU_USERNAME=your_student_number
SU_PASSWORD=your_password_here

# Only needed for the weekly-menu photo upload feature (calls the Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: gates the dashboard's own /login screen (separate from the SU
# credentials above). If unset, signing in only works via the "Continue with
# default account" bypass button on /login -- see web/README.md's
# "Dashboard login gate" section.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional: signs the dashboard's session cookie. Set this to a random string
# (e.g. `openssl rand -base64 32`) so login sessions survive server restarts;
# otherwise a fixed, publicly-known dev default is used.
AUTH_SECRET=
